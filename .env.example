# ── MetaTrader 5 ──────────────────────────────────
MT5_LOGIN=123456
MT5_PASSWORD=ton_mot_de_passe_ici
MT5_SERVER=NomDuBroker-Demo

# ── Logging ───────────────────────────────────────
# Niveaux disponibles: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Telegram (optionnel) ──────────────────────────
